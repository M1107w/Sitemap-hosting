# Copy to .env and fill in.
# Your free DuckDNS name (see MORNING_REPORT step 3)
DOMAIN=yourname.duckdns.org

# AI model run by Ollama. qwen3:4b = good balance on Oracle's free ARM VM.
# Faster but simpler: qwen3:1.7b   Smarter but slower: qwen3:8b
OLLAMA_MODEL=qwen3:4b

# Speech-to-text model: tiny.en (fastest) / base.en (default) / small.en (most accurate)
WHISPER_MODEL=base.en

# Voice for spoken replies (British male). Others: en_GB-jenny_dioco-medium, en_US-ryan-high
PIPER_VOICE=en_GB-alan-medium
